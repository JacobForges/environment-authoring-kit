#!/bin/sh
# Strip Cursor co-author trailers (see Packages/com.cursor.environment-authoring-kit/.cursor/rules/git-commit-as-user.mdc)
COMMIT_MSG_FILE=$1
[ -f "$COMMIT_MSG_FILE" ] || exit 0
grep -v '^Co-authored-by: Cursor <cursoragent@cursor.com>$' "$COMMIT_MSG_FILE" > "${COMMIT_MSG_FILE}.tmp" && mv "${COMMIT_MSG_FILE}.tmp" "$COMMIT_MSG_FILE"
