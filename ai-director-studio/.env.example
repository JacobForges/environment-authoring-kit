# Setup:  cp .env.example .env   then edit .env (never commit .env)
# Do NOT run:  cp .env.example CURSOR_API_KEY  — that is wrong.

# Required — Cursor API key for director chat, script, and recap AI
CURSOR_API_KEY=

# Where project media + compose output live (default: ~/Library/AIDirectorStudio)
DIRECTOR_DATA_ROOT=

# Optional — model for planner-llm.ts / demo-recap-pipeline.ts
# CAVE_CURSOR_MODEL=composer-2.5

# Standalone mode (skip Unity compose gates) — enabled by start.sh
# STANDALONE=1

# Optional — API port (default 8767)
# AI_DIRECTOR_PORT=8767

# Optional — AI instrumental generation (Music flow). Without this, upload an MP3 instrumental in the UI.
SUNO_API_KEY=
# SUNO_API_URL=https://api.sunoapi.org/api/v1/generate
